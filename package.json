{
	"name": "transformer-explainer",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:localization": "node scripts/check-localization.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"deploy": "gh-pages -d build --nojekyll",
		"deploy-temp": "gh-pages -d build --nojekyll --repo https://github.com/aereeeee/te-temp.git"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.2.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.53.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/d3-array": "^3.2.1",
		"@types/d3-ease": "^3.0.2",
		"@types/d3-interpolate": "^3.0.4",
		"@types/d3-scale": "^4.0.8",
		"@types/d3-selection": "^3.0.10",
		"@types/d3-transition": "^3.0.8",
		"@types/eslint": "^8.56.0",
		"@types/gsap": "^3.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"autoprefixer": "^10.4.16",
		"classnames": "^2.5.1",
		"d3-array": "^3.2.4",
		"d3-ease": "^3.0.1",
		"d3-interpolate": "^3.0.1",
		"d3-scale": "^4.0.2",
		"d3-selection": "^3.0.0",
		"d3-transition": "^3.0.1",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"flowbite": "^2.3.0",
		"flowbite-svelte": "^0.46.1",
		"flowbite-svelte-icons": "^1.6.1",
		"gh-pages": "^6.1.1",
		"postcss": "^8.4.33",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"prettier-plugin-tailwindcss": "^0.5.1",
		"sass": "^1.77.1",
		"svelte": "^5.53.5",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^3.4.1",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^6.3.0"
	},
	"type": "module",
	"dependencies": {
		"@xenova/transformers": "^2.17.1",
		"gsap": "^3.12.5",
		"katex": "^0.16.10",
		"onnxruntime-web": "^1.23.0"
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	}
}
